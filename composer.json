{
    "name": "pikbdesigns/laravel-full-translation",
    "type": "library",
    "description": "URL-based localization for Laravel without rewriting every route",
    "keywords": ["laravel", "localization", "translation", "multilingual", "i18n"],
    "license": "MIT",
    "authors": [
        {
            "name": "pikbdesigns",
            "email": "pikbdesigns@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Pikbdesigns\\FullTranslation\\": "src/"
        },
        "files": ["src/Helpers/localization.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Pikbdesigns\\FullTranslation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pikbdesigns\\FullTranslation\\LocalizationServiceProvider"
            ],
            "aliases": {
                "FullLocalization": "Pikbdesigns\\FullTranslation\\Facades\\FullLocalization"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
